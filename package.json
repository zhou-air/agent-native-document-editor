{
  "name": "agent-document",
  "productName": "Agent Document",
  "version": "0.2.0",
  "description": "Local structured technical document workbench",
  "type": "module",
  "main": "src/service.js",
  "author": "Agent Document contributors",
  "license": "MIT",
  "scripts": {
    "build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/publish-winui.ps1",
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/launch-winui.ps1",
    "serve": "node src/service.js",
    "mcp": "node src/mcp.js",
    "test": "node --test tests/store-v2.test.js tests/semantic-docx.test.js tests/service-v2.test.js tests/migration-content.test.js tests/store-review.test.js tests/project-catalog.test.js",
    "test:native": "dotnet run --project native/AgentDocument.ClientChecks && dotnet run --project native/AgentDocument.EditorChecks",
    "benchmark": "node scripts/benchmark-v2.mjs",
    "migrate": "node scripts/migrate-project.mjs",
    "package:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/publish-winui.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "marked": "^18.1.1",
    "proper-lockfile": "^4.1.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
